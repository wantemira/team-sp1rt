          "name": "Вход: demo.ip@example.com",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.ip@example.com\",\n  \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"JWT выдан\", () => { pm.expect(result.access_token).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"client_token\", result.access_token);"
